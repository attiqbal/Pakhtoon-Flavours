# Copy to .env (the start script does this for you) and fill in. Never commit .env.

# Owner dashboard password, used once on first start. Change it later in Settings.
OWNER_PASSWORD=

# Claude API key from console.anthropic.com. Without it the site still works; chat messages come to you to answer.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# The site's public address (used in order links and the calendar feed). The start script sets this in Codespaces.
# PASHTOON_BASE_URL=https://www.thepashtoonflavours.co.uk

# Optional: WhatsApp Cloud API, so the same assistant answers WhatsApp. Webhook URL: <your address>/webhook/whatsapp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
