# Copy to .env (the start script does this for you) and fill in. Never commit .env.

# Owner dashboard password, used once on first start. Change it later in Settings.
# Owner login is created automatically (see README, The owner account). Nothing to set here.

# Claude API key from console.anthropic.com. Without it the site still works; chat messages come to you to answer.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# The site's public address (used in order links and the calendar feed). The start script sets this in Codespaces.
# PASHTOON_BASE_URL=https://www.thepashtoonflavours.co.uk

# Optional Meta channels: WhatsApp, Instagram and Facebook Messenger (README > Meta apps).
# One webhook for all three: <your address>/webhook/meta
META_APP_SECRET=
META_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
INSTAGRAM_TOKEN=
META_PAGE_TOKEN=

# Optional card payments with Stripe (cards, Apple Pay, Google Pay). README > Card payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional Google Calendar sync of orders (docs/google-calendar.md). Redirect URI: <site address>/owner/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Which AI runs the assistant: anthropic (Claude, default) or openai (ChatGPT or any OpenAI-compatible service).
# Also switchable in Owner > Settings. Empty CLAUDE_MODEL means claude-opus-5-5, the strongest.
AI_PROVIDER=anthropic
CLAUDE_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_BASE_URL=https://api.openai.com/v1

# Alerts to her phone (all optional). Email also sends the weekly backup if she ticks it.
WHATSAPP_OWNER_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en_GB
NTFY_SERVER=https://ntfy.sh
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Going live (see DEPLOY.md)
DOMAIN=
SESSION_SECRET=
PASHTOON_BASE_URL=
PASHTOON_BACKUP_KEEP=30
